<?xml version="1.0"?>
<sdf version="1.10">
  <world name="small_rover_drive_test">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="gz-physics" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.2</mu2></ode></friction></surface></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
    <!-- Outer boundary -->
    <model name="wall_1"><static>true</static><pose>-1.75 3 0.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.5 0.1 0.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.5 0.1 0.5</size></box></geometry><material><diffuse>0.30 0.34 0.40 1</diffuse></material></visual></link></model>
    <model name="wall_2"><static>true</static><pose>1.75 3 0.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.5 0.1 0.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.5 0.1 0.5</size></box></geometry><material><diffuse>0.30 0.34 0.40 1</diffuse></material></visual></link></model>
    <model name="wall_3"><static>true</static><pose>0 -3 0.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6.1 0.1 0.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>6.1 0.1 0.5</size></box></geometry><material><diffuse>0.30 0.34 0.40 1</diffuse></material></visual></link></model>
    <model name="wall_4"><static>true</static><pose>3 0 0.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 6.1 0.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6.1 0.5</size></box></geometry><material><diffuse>0.30 0.34 0.40 1</diffuse></material></visual></link></model>
    <model name="wall_5"><static>true</static><pose>-3 0 0.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 6.1 0.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6.1 0.5</size></box></geometry><material><diffuse>0.30 0.34 0.40 1</diffuse></material></visual></link></model>

    <!-- Staggered maze walls leave corridors at least 0.8 m wide. -->
    <model name="wall_6"><static>true</static><pose>-1.8 -1.775 0.2 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 2.25 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 2.25 0.4</size></box></geometry><material><diffuse>0.48 0.52 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_7"><static>true</static><pose>-1.8 0.525 0.2 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 0.55 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 0.55 0.4</size></box></geometry><material><diffuse>0.48 0.52 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_8"><static>true</static><pose>-0.4 0.8 0.2 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.8 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.8 0.1 0.4</size></box></geometry><material><diffuse>0.48 0.52 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_9"><static>true</static><pose>1.0 1.85 0.2 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 2.3 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 2.3 0.4</size></box></geometry><material><diffuse>0.48 0.52 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_10"><static>true</static><pose>0.2 -1.2 0.2 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.2 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.2 0.1 0.4</size></box></geometry><material><diffuse>0.48 0.52 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_11"><static>true</static><pose>2.1 -2.05 0.2 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 1.7 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 1.7 0.4</size></box></geometry><material><diffuse>0.48 0.52 0.58 1</diffuse></material></visual></link></model>
  </world>
</sdf>
