<?xml version="1.0"?>
<sdf version="1.10">
  <model name="sverk_mecanum_wheel_right">
    <!-- This is a suspended single-wheel inspection model, not a vehicle. -->
    <link name="wheel_mount">
      <gravity>false</gravity>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <visual name="mount_marker">
        <geometry>
          <sphere><radius>0.002</radius></sphere>
        </geometry>
        <material><diffuse>0.9 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_hub">
      <gravity>false</gravity>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.000030</ixx>
          <iyy>0.000020</iyy>
          <izz>0.000020</izz>
        </inertia>
      </inertial>
      <visual name="wheel_mesh">
        <geometry>
          <mesh>
            <uri>model://sverk_mecanum_wheel_right/meshes/Mecanum_Wheel_60mm_Right.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="hub_collision">
        <pose>0 0 0 0 1.570796327 0</pose>
        <geometry>
          <cylinder><radius>0.017</radius><length>0.022</length></cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="wheel_joint" type="revolute">
      <parent>wheel_mount</parent>
      <child>wheel_hub</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>2</effort><velocity>100</velocity></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>

    <!-- Roller 0 centre is (0.003, 22.937, -1.705) mm; its measured central-axis direction is (0.707107, -0.053382, -0.705129). -->
    <link name="roller_0"><pose relative_to="wheel_hub">0.000003 0.022937 -0.001705 0 0.782577251 -0.075350181</pose><gravity>false</gravity><inertial><mass>0.003</mass><inertia><ixx>0.00000002</ixx><iyy>0.00000024</iyy><izz>0.00000024</izz></inertia></inertial><visual name="mesh"><geometry><mesh><uri>model://sverk_mecanum_wheel_right/meshes/roller_Varsayilan.obj</uri></mesh></geometry></visual><collision name="collision"><pose>0 0 0 0 1.570796327 0</pose><geometry><cylinder><radius>0.0059</radius><length>0.0308</length></cylinder></geometry></collision></link>
